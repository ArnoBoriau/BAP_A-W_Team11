# Notion integration. Copy this file to .env and fill it in. Never commit .env.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
#
# 1. Amber (workspace owner; guests can't do this): notion.so/profile/integrations → New integration,
#    internal, "Read content" only. Copy the Internal Integration Secret below.
# 2. On the BAP page in Notion: ••• → Connections → add the integration. It can then read every database below it.
# 3. Paste the link (or the 32-character id) of each database the site should read.
#    Leave one empty and the site keeps using the local files for it.
# 4. Check the mapping with `npm run notion:inspect`.

NOTION_TOKEN=

# BAP → Behind the scenes → Databases
NOTION_LOGBOOK_DB=
NOTION_TIME_DB=
# Planning: rows in the Deadlines and Meetings groups become dates, the rest tasks.
NOTION_PLANNING_DB=
NOTION_TEAM_DB=

# Optional, for instant updates: the verification token Notion sends when you add the webhook (see README).
NOTION_WEBHOOK_SECRET=
