---
// A ring of slanted tiles around whatever is passed in (the slot), after the country tiles in the
// ARCHITECT@WORK identity. Every tile is a link; they float slowly and shift a little with the cursor.
// On narrow screens the slot comes first and the tiles follow in a grid.

export interface Tile {
	label: string;
	sub?: string;
	href: string;
	color: string;
	/** Position of the tile's top-left corner, in % of the cluster. */
	x: number;
	y: number;
	/** Slant direction: up to the right, or down to the right. */
	slant: 'up' | 'down';
	/** How strongly it follows the cursor. */
	depth?: number;
}

interface Props {
	tiles: Tile[];
	label: string;
}

const { tiles, label } = Astro.props;
---

<div class="cluster" data-cluster>
	<div class="centre"><slot /></div>
	<nav class="ring" aria-label={label}>
	{
		tiles.map((t, i) => (
			<a
				href={t.href}
				class:list={['tile', t.slant]}
				style={`--x: ${t.x}%; --y: ${t.y}%; --c: ${t.color}; --d: ${t.depth ?? 1}; --i: ${i}`}
			>
				<span class="face">
					<span class="name">{t.label}</span>
					{t.sub && <span class="sub">{t.sub}</span>}
				</span>
			</a>
		))
	}
	</nav>
</div>

<script>
	document.addEventListener('astro:page-load', () => {
		const cluster = document.querySelector<HTMLElement>('[data-cluster]');
		if (!cluster || !matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) return;
		cluster.addEventListener('pointermove', (e) => {
			const box = cluster.getBoundingClientRect();
			cluster.style.setProperty('--mx', String(((e.clientX - box.left) / box.width - 0.5) * 2));
			cluster.style.setProperty('--my', String(((e.clientY - box.top) / box.height - 0.5) * 2));
		});
		cluster.addEventListener('pointerleave', () => {
			cluster.style.setProperty('--mx', '0');
			cluster.style.setProperty('--my', '0');
		});
	});
</script>

<style>
	.cluster {
		--mx: 0;
		--my: 0;
		--slant: 16deg; /* how far the tiles tilt */
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 680px;
		margin-inline: auto;
	}

	.centre {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	.centre > :global(*) {
		pointer-events: auto;
	}

	.tile {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: 18%;
		aspect-ratio: 16 / 9;
		color: var(--ink);
		text-decoration: none;
		transform: translate(calc(var(--mx) * var(--d) * -14px), calc(var(--my) * var(--d) * -10px));
		transition: transform 0.6s var(--ease);
		animation: tile-in 0.9s calc(0.1s + var(--i) * 0.08s) var(--ease) both;
	}

	.face {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 10px 12px;
		background: var(--c);
		animation: float 7s calc(var(--i) * -1.3s) ease-in-out infinite;
		transition:
			filter 0.3s,
			translate 0.4s var(--ease);
	}

	.up .face {
		transform: skewY(calc(-1 * var(--slant)));
	}

	.down .face {
		transform: skewY(var(--slant));
	}

	.name {
		font-family: var(--font-display);
		font-size: clamp(14px, 1.6vw, 18px);
		font-weight: 700;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.sub {
		margin-top: 2px;
		font-size: 12px;
		font-weight: 700;
		opacity: 0.7;
	}

	.tile:hover,
	.tile:focus-visible {
		z-index: 2;
	}

	.tile:hover .face,
	.tile:focus-visible .face {
		translate: 0 -10px;
		filter: brightness(1.08);
		box-shadow: 0 18px 30px rgba(0, 0, 0, 0.45);
	}

	.tile:focus-visible {
		outline: none;
	}

	.tile:focus-visible .face {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}

	@media (max-width: 760px) {
		.cluster {
			aspect-ratio: auto;
			max-height: none;
		}

		.centre {
			position: static;
			padding-block: 24px 48px;
		}

		/* Three small tiles per row, with room above and below for their slant. */
		.ring {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 8px 16px;
			padding-block: 8px;
		}

		.tile {
			position: relative;
			left: auto;
			top: auto;
			width: 100%;
			max-width: 200px;
			justify-self: center;
			/* A 16° slant reaches about 15% of the tile's width above and below it (% margins follow the column width). */
			margin-block: 20%;
		}
	}

	@keyframes float {
		50% {
			margin-top: -8px;
			margin-bottom: 8px;
		}
	}

	@keyframes tile-in {
		from {
			opacity: 0;
			translate: 0 40px;
		}
	}
</style>
