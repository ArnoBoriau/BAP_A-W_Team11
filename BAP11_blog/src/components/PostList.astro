---
// Logbook posts as rows: date, title with summary, pillar and tags. The whole row is a link.
import { PILLARS, TAGS } from '../consts';
import type { Post } from '../lib/data';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entries: Post[];
	filterable?: boolean;
}

const { entries, filterable = false } = Astro.props;
---

<ul class="posts" data-stagger>
	{
		entries.map((entry) => (
			<li
				data-pillar={filterable ? entry.data.pillar : undefined}
				data-tags={filterable ? entry.data.tags.join(' ') : undefined}
				style={`--c: ${PILLARS[entry.data.pillar].color}`}
			>
				<span class="date">
					<FormattedDate date={entry.data.date} />
				</span>
				<div class="text">
					<a href={`/logbook/${entry.id}/`} class="title" transition:name={`post-${entry.id}`}>
						{entry.data.title}
					</a>
					{entry.data.description && <p>{entry.data.description}</p>}
				</div>
				<span class="badges">
					<span class="pillar" style={`--c: ${PILLARS[entry.data.pillar].color}`}>
						{PILLARS[entry.data.pillar].label}
					</span>
					{entry.data.tags.map((tag) => (
						<span class="tag">{TAGS[tag]}</span>
					))}
				</span>
			</li>
		))
	}
</ul>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line-strong);
	}

	li {
		position: relative;
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr) minmax(0, 260px);
		gap: 8px 24px;
		align-items: start;
		padding: 22px 0;
		border-bottom: 1px solid var(--line);
		transition: padding 0.4s var(--ease);
	}

	/* A slanted bar in the pillar colour slides in on hover, and the row makes room for it. */
	li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 22px;
		width: 14px;
		height: 26px;
		background: var(--c);
		clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s var(--ease);
	}

	li:hover {
		padding-left: 28px;
	}

	li:hover::before {
		transform: scaleX(1);
	}

	.date {
		padding-top: 3px;
		font-size: 14px;
		font-weight: 700;
		color: var(--muted);
		white-space: nowrap;
	}

	.title {
		display: inline-block;
		font-size: 22px;
		line-height: 1.25;
		text-decoration: none;
	}

	/* The whole row is clickable without nesting links. */
	.title::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	li:hover .title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.text p {
		margin-top: 4px;
		max-width: 65ch;
		color: var(--muted);
		font-size: 15px;
	}

	.badges {
		justify-content: flex-end;
		padding-top: 3px;
	}

	li[hidden] {
		display: none;
	}

	@media (max-width: 820px) {
		li {
			grid-template-columns: 1fr;
		}

		li:hover {
			padding-left: 0;
		}

		li::before {
			display: none;
		}

		.badges {
			justify-content: flex-start;
		}
	}
</style>
