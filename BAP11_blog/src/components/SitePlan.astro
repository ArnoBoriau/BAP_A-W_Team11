---
// Schematic plan of the arrival zone at Kortrijk Xpo with agora.: an open gate in each hall, about 90 m apart.
// Not to scale. The gates are the only thing in colour.
---

<figure class="plan">
	<svg viewBox="0 0 640 320" role="img" aria-labelledby="plan-title plan-desc">
		<title id="plan-title">Plan of the arrival zone</title>
		<desc id="plan-desc">
			Visitors enter through the entrance tent and turn left or right into one of two halls. Each hall
			has an open gate to walk through, about 90 metres from the other.
		</desc>

		<defs>
			<pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
				<line x1="0" y1="0" x2="0" y2="6" stroke="rgba(237,234,228,0.25)" stroke-width="1"></line>
			</pattern>
			<marker id="tick" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="10" markerHeight="10" orient="auto">
				<line x1="2" y1="8" x2="8" y2="2" stroke="currentColor" stroke-width="1.4"></line>
			</marker>
			<marker id="arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M1 1 L8 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.4"></path>
			</marker>
		</defs>

		<!-- Halls -->
		<g class="outline">
			<rect x="20" y="40" width="220" height="210"></rect>
			<rect x="400" y="40" width="220" height="210"></rect>
		</g>
		<!-- Hallway between the halls, at the height of the gates (the middle of the halls) -->
		<rect x="240" y="115" width="160" height="60" fill="url(#hatch)" opacity="0.6"></rect>
		<g class="outline thin">
			<line x1="240" y1="115" x2="400" y2="115"></line>
			<line x1="240" y1="175" x2="400" y2="175"></line>
		</g>
		<!-- Entrance tent -->
		<path class="outline" d="M270 175 L370 175 L370 255 L320 285 L270 255 Z"></path>

		<!-- Gates: a game screen and an animation wall, joined by the animation ceiling, open to walk through -->
		<g>
			<rect class="ceiling" x="143" y="127" width="70" height="36"></rect>
			<rect class="gate" x="143" y="127" width="70" height="6"></rect>
			<rect class="gate" x="143" y="157" width="70" height="6"></rect>
		</g>
		<g>
			<rect class="ceiling" x="427" y="127" width="70" height="36"></rect>
			<rect class="gate" x="427" y="127" width="70" height="6"></rect>
			<rect class="gate" x="427" y="157" width="70" height="6"></rect>
		</g>

		<!-- Dimension line -->
		<g class="dim">
			<line x1="178" y1="66" x2="462" y2="66" marker-start="url(#tick)" marker-end="url(#tick)"></line>
			<line x1="178" y1="58" x2="178" y2="100"></line>
			<line x1="462" y1="58" x2="462" y2="100"></line>
		</g>
		<text class="dim-label" x="320" y="56" text-anchor="middle">± 90 m</text>

		<!-- Visitor flow -->
		<g class="flow">
			<path d="M320 268 L320 185 Q320 145 280 145 L250 145" marker-end="url(#arrow)"></path>
			<path d="M320 185 Q320 145 360 145 L390 145" marker-end="url(#arrow)"></path>
		</g>

		<!-- Labels -->
		<g class="label">
			<text x="36" y="66">Hall</text>
			<text x="604" y="66" text-anchor="end">Hall</text>
			<text x="178" y="184" text-anchor="middle">Gate</text>
			<text x="462" y="184" text-anchor="middle">Gate</text>
			<text x="320" y="306" text-anchor="middle">Entrance tent</text>
		</g>
	</svg>
	<figcaption>
		An open gate in each hall, about 90 m apart. Schematic, not to scale.
	</figcaption>
</figure>

<style>
	.plan {
		margin: 0;
		padding: 24px;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		color: var(--fg);
	}

	.outline {
		fill: none;
		stroke: var(--fg-soft);
		stroke-width: 1.5;
	}

	.outline.thin {
		stroke-width: 1;
	}

	.gate {
		fill: var(--accent);
	}

	.ceiling {
		fill: var(--accent);
		opacity: 0.25;
	}


	.dim {
		color: var(--accent-text);
		stroke: var(--accent-text);
		stroke-width: 1;
	}

	.dim-label {
		fill: var(--accent-text);
		font-family: var(--font-display);
		font-size: 13px;
		font-weight: 700;
	}

	.flow {
		color: var(--muted);
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.25;
		stroke-dasharray: 4 4;
	}

	.label {
		fill: var(--muted);
		font-family: var(--font-display);
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	figcaption {
		margin-top: 16px;
		padding-top: 12px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 14px;
	}
</style>
