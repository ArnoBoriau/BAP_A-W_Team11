---
import FormattedDate from '../components/FormattedDate.astro';
import { PILLAR_IDS, PILLARS, TASK_STATUS_LABELS, TASK_STATUSES } from '../consts';
import Layout from '../layouts/Layout.astro';
import { DAY, getPlanning, getTeam, inWeek, today, weekEnd } from '../lib/data';

const [{ weeks, milestones, tasks }, team] = await Promise.all([getPlanning(), getTeam()]);
const now = today();

const isCurrent = (w: (typeof weeks)[number]) => inWeek(now, w);

const member = (id: string) => team.find((m) => m.id === id);
const progress = (w: (typeof weeks)[number]) =>
	Math.min(1, Math.max(0, (now.valueOf() - w.data.start.valueOf()) / (weekEnd(w.data.end).valueOf() + DAY - w.data.start.valueOf())));
const typeLabel = { deadline: 'Deadline', event: 'Event', jury: 'Jury' } as const;
const done = tasks.filter((t) => t.data.status === 'done').length;

// Board filters. A task's week is free text from Notion ("Week 1 · Pitch deck", "Weeks 2–3 · Concept", "Ongoing"),
// so it is mapped onto the weeks of the overview. Anything that names no week, like "Ongoing", gets its own filter.
const slug = (s: string) => s.trim().toLowerCase().replace(/\s+/g, '-');
const weeksOf = (text: string) => {
	const head = text.split('·')[0].trim().toLowerCase();
	const range = head.match(/^weeks?\s+(\d+)(?:\s*[–-]\s*(\d+))?/);
	if (range) {
		const from = Number(range[1]);
		const to = Number(range[2] ?? from);
		return Array.from({ length: Math.max(1, to - from + 1) }, (_, i) => `week-${from + i}`);
	}
	return [slug(head)];
};
const weekIds = new Set(weeks.map((w) => slug(w.data.label)));
const extraWeeks = [...new Set(tasks.flatMap((t) => weeksOf(t.data.week)).filter((id) => !weekIds.has(id)))];
const filterGroups = [
	{
		key: 'week',
		label: 'Week',
		options: [
			...extraWeeks.map((id) => ({ id, label: tasks.find((t) => weeksOf(t.data.week).includes(id))!.data.week.split('·')[0].trim() })),
			...weeks.map((w) => ({ id: slug(w.data.label), label: w.data.label, current: isCurrent(w) })),
		],
	},
	{
		key: 'pillar',
		label: 'Pillar',
		options: PILLAR_IDS.map((id) => ({ id, label: PILLARS[id].label })),
	},
	{
		key: 'who',
		label: 'Who',
		options: team.map((m) => ({ id: m.id, label: m.data.name.split(' ')[0] })),
	},
];
const tasksFor = (key: string, id: string) =>
	tasks.filter((t) =>
		key === 'week' ? weeksOf(t.data.week).includes(id) : key === 'pillar' ? t.data.pillar === id : t.data.owners.some((o) => o.id === id),
	).length;
---

<Layout title="Planning" description="Our seven weeks, every deadline and the task board.">
	<section class="wrap page-head">
		<p class="label">{weeks.length} weeks · {milestones.length} dates · {tasks.length} tasks</p>
		<h1>Planning</h1>
		<p class="lead">
			Seven weeks from 27 October to the jury on 17 December, with the autumn break in between. Deadlines are at
			22:00 unless stated otherwise.
		</p>
	</section>

	<section class="wrap">
		<h2 class="sr-only">Weeks</h2>
		<ol class="weeks" data-stagger>
			{
				weeks.map((w) => {
					const items = milestones.filter((m) => inWeek(m.data.date, w));
					return (
						<li class:list={{ current: isCurrent(w), past: weekEnd(w.data.end) < now }} aria-current={isCurrent(w) ? 'date' : undefined}>
							<p class="wlabel">
								{w.data.label}
								{isCurrent(w) && <span class="now">This week</span>}
							</p>
							<p class="wdates">
								<FormattedDate date={w.data.start} /> – <FormattedDate date={w.data.end} />
							</p>
							<p class="wfocus">{w.data.focus}</p>
							{isCurrent(w) && (
								<span class="progress" style={`--p: ${progress(w)}`} role="img" aria-label={`${Math.round(progress(w) * 100)}% of this week done`} />
							)}
							{items.length > 0 && (
								<ul class="wmiles">
									{items.map((m) => (
										<li class={m.data.type}>
											<span class="d">
												<FormattedDate date={m.data.date} style="day" />
											</span>
											{m.data.title}
										</li>
									))}
								</ul>
							)}
						</li>
					);
				})
			}
		</ol>
	</section>

	<section class="wrap section">
		<div class="sec-head">
			<h2>All dates</h2>
		</div>
		<div class="table-scroll">
			<table class="data">
				<thead>
					<tr><th>Date</th><th>What</th><th>Time</th><th>Type</th></tr>
				</thead>
				<tbody>
					{
						milestones.map((m) => (
							<tr class:list={[m.data.type, { past: m.data.date < now }]}>
								<td class="date"><FormattedDate date={m.data.date} style="day" /></td>
								<td class="what">{m.data.title}</td>
								<td class="muted">{m.data.time ?? ''}</td>
								<td><span class="type">{typeLabel[m.data.type]}</span></td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section class="wrap section">
		<div class="sec-head">
			<h2>Task board</h2>
			<div class="sec-meta">
				<button type="button" class="clear label" data-reset hidden>Clear filters</button>
				<span class="label" data-done>{done} of {tasks.length} done</span>
			</div>
		</div>

		<div class="filters" data-filters>
			{
				filterGroups.map((g) => (
					<label class="filter">
						<span class="label">{g.label}</span>
						<select data-key={g.key}>
							<option value="">All</option>
							{g.options.map((o) => (
								<option value={o.id}>
									{o.label}
									{'current' in o && o.current ? ' · this week' : ''} ({tasksFor(g.key, o.id)})
								</option>
							))}
						</select>
					</label>
				))
			}
		</div>

		<div class="board" data-stagger data-board>
			{
				TASK_STATUSES.map((status) => {
					const list = tasks.filter((t) => t.data.status === status);
					return (
						<div class:list={['col', status]}>
							<h3>
								{TASK_STATUS_LABELS[status]} <span class="count" data-count>{list.length}</span>
							</h3>
							<ul>
								{list.map((t) => (
									<li
										data-week={weeksOf(t.data.week).join(' ')}
										data-pillar={t.data.pillar ?? ''}
										data-who={t.data.owners.map((o) => o.id).join(' ')}
									>
										<span class="ttitle">{t.data.title}</span>
										{t.data.notes && <span class="tnotes">{t.data.notes}</span>}
										<span class="tmeta">
											<span class="owners" aria-hidden="true">
												{t.data.owners.map((o) => (
													<span class="swatch" style={`background: ${member(o.id)?.color ?? 'var(--muted)'}`} />
												))}
											</span>
											{t.data.owners.length === team.length
												? 'Everyone'
												: t.data.owners.map((o) => member(o.id)?.data.name.split(' ')[0] ?? o.id).join(', ')}
											{' · '}
											{t.data.week}
										</span>
									</li>
								))}
							</ul>
						</div>
					);
				})
			}
		</div>

		<p class="empty" data-empty hidden>
			No tasks match these filters. <button type="button" class="btn" data-reset>Show all tasks</button>
		</p>
	</section>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		const board = document.querySelector('[data-board]');
		if (!board) return;
		const selects = [...document.querySelectorAll<HTMLSelectElement>('[data-filters] select')];
		const clear = document.querySelector<HTMLElement>('.clear[data-reset]')!;
		const cols = [...board.querySelectorAll<HTMLElement>('.col')];
		const empty = document.querySelector<HTMLElement>('[data-empty]')!;
		const doneLabel = document.querySelector<HTMLElement>('[data-done]')!;
		const keys = ['week', 'pillar', 'who'];
		const params = new URL(location.href).searchParams;
		const state: Record<string, string> = Object.fromEntries(keys.map((k) => [k, params.get(k) ?? '']));

		function apply(push = true) {
			// Unknown values from the URL fall back to "All".
			selects.forEach((s) => {
				s.value = state[s.dataset.key!];
				state[s.dataset.key!] = s.value;
				s.closest('.filter')!.classList.toggle('active', s.value !== '');
			});
			let shown = 0;
			let done = 0;
			cols.forEach((col) => {
				const rows = [...col.querySelectorAll<HTMLLIElement>('li')];
				const visible = rows.filter((row) => {
					const match = keys.every((k) => !state[k] || (row.dataset[k] ?? '').split(' ').includes(state[k]));
					row.hidden = !match;
					return match;
				}).length;
				col.querySelector('[data-count]')!.textContent = String(visible);
				shown += visible;
				if (col.classList.contains('done')) done = visible;
			});
			clear.hidden = keys.every((k) => !state[k]);
			doneLabel.textContent = `${done} of ${shown} done`;
			empty.hidden = shown > 0;
			if (push) {
				const url = new URL(location.href);
				keys.forEach((k) => (state[k] ? url.searchParams.set(k, state[k]) : url.searchParams.delete(k)));
				history.replaceState(null, '', url);
			}
		}

		selects.forEach((s) =>
			s.addEventListener('change', () => {
				state[s.dataset.key!] = s.value;
				apply();
			}),
		);
		document.querySelectorAll('[data-reset]').forEach((b) =>
			b.addEventListener('click', () => {
				keys.forEach((k) => (state[k] = ''));
				apply();
			}),
		);
		apply(false);
	});
</script>

<style>
	/* Week overview */
	.weeks {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.weeks > li {
		padding: 16px 18px 20px;
		background: var(--surface);
		border-top: 4px solid var(--surface-2);
	}

	.weeks > li.past {
		color: var(--muted);
	}

	.weeks > li.current {
		background: var(--surface-2);
		border-top-color: var(--accent);
	}

	.wlabel {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 4px 8px;
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.now {
		color: var(--accent);
	}

	/* How far we are into the current week. */
	.progress {
		display: block;
		height: 4px;
		margin-top: 14px;
		background: var(--line);
	}

	.progress::after {
		content: '';
		display: block;
		height: 100%;
		width: calc(var(--p) * 100%);
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 1.2s 0.4s var(--ease);
	}

	.is-in .progress::after {
		transform: none;
	}

	.wdates {
		margin-top: 2px;
		font-size: 14px;
		color: var(--muted);
	}

	.wfocus {
		margin-top: 12px;
		font-size: 18px;
		line-height: 1.3;
	}

	.wmiles {
		margin: 14px 0 0;
		padding: 12px 0 0;
		list-style: none;
		border-top: 1px solid var(--line);
		font-size: 14px;
		line-height: 1.4;
	}

	.wmiles li + li {
		margin-top: 8px;
	}

	.wmiles .d {
		display: block;
		font-weight: 700;
		color: var(--muted);
	}

	.wmiles .deadline .d {
		color: var(--deadline);
	}

	.wmiles .jury {
		font-weight: 700;
	}

	/* All dates */
	td.date {
		white-space: nowrap;
		font-weight: 700;
	}

	tr.past td {
		color: var(--muted);
	}

	.type {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
	}

	tr.deadline .type,
	tr.deadline td.date {
		color: var(--deadline);
	}

	tr.jury .type,
	tr.jury .what {
		color: var(--fg);
		font-weight: 700;
	}

	tr.past.deadline td.date,
	tr.past.deadline .type {
		color: var(--muted);
	}

	/* Task board filters */
	.sec-meta {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.clear {
		padding: 0;
		border: 0;
		background: none;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.clear:hover {
		color: var(--accent);
	}

	.clear[hidden] {
		display: none;
	}

	/* A strip of filter blocks that lines up with the three board columns. */
	.filters {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
		margin-bottom: 6px;
	}

	.col li[hidden] {
		display: none;
	}

	.empty {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		padding: 24px 0;
		color: var(--muted);
	}

	.empty[hidden] {
		display: none;
	}

	/* Task board */
	.board {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
		align-items: start;
	}

	.col {
		padding: 18px 20px;
		background: var(--surface);
	}

	.col h3 {
		display: flex;
		justify-content: space-between;
		padding-bottom: 12px;
		border-bottom: 2px solid var(--line-strong);
		font-size: 14px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.doing h3 {
		border-bottom-color: var(--accent);
	}

	.count {
		color: var(--muted);
	}

	.col ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.col li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
	}

	.col li:last-child {
		border-bottom: 0;
	}

	.ttitle {
		font-size: 16px;
	}

	.done .ttitle {
		color: var(--muted);
	}

	.tnotes {
		font-size: 14px;
		color: var(--muted);
	}

	.tmeta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--muted);
	}

	.owners {
		display: flex;
		gap: 3px;
	}

	.swatch {
		width: 8px;
		height: 8px;
	}

	@media (max-width: 900px) {
		.weeks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.board {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.weeks,
		.filters {
			grid-template-columns: 1fr;
		}
	}
</style>
