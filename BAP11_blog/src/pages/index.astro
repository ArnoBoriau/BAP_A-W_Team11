---
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import SitePlan from '../components/SitePlan.astro';
import Tiles from '../components/Tiles.astro';
import { CLIENT_CONTACTS, PILLARS, PROJECT } from '../consts';
import Layout from '../layouts/Layout.astro';
import { DAY, formatHours, getEntries, getPlanning, getTimeLog, sum, today } from '../lib/data';

const [entries, time, { weeks, milestones }] = await Promise.all([getEntries(), getTimeLog(), getPlanning()]);

const now = today();
const upcoming = milestones.filter((m) => m.data.date >= now).slice(0, 4);
const currentWeek =
	weeks.find((w) => w.data.start <= now && now <= new Date(w.data.end.valueOf() + 2 * DAY)) ??
	weeks.find((w) => w.data.start > now);
const totalHours = sum(time.map((t) => t.data.hours));
const brainstorm = entries.find((e) => e.id.includes('brainstorm'));

const has = (fn: (e: (typeof entries)[number]) => boolean) => entries.filter(fn).length;
const tagged = (...tags: string[]) => (e: (typeof entries)[number]) => tags.some((t) => e.data.tags.includes(t as never));
const inPillar = (id: string) => (e: (typeof entries)[number]) => e.data.pillar === id;
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// The parts of the BAP assignment, and where to find each of them.
const requirements = [
	{ what: 'Research documentation', where: 'Logbook, Research tag', href: '/logbook/?f=research', stat: plural(has(tagged('research')), 'post') },
	{ what: 'Process towards the result', where: 'Logbook, Process tag', href: '/logbook/?f=process', stat: plural(has(tagged('process')), 'post') },
	{ what: 'Feedback reports', where: 'Logbook, Feedback & experts', href: '/logbook/?f=feedback', stat: plural(has(tagged('feedback-client', 'expert-talk')), 'report') },
	{ what: 'Team roles', where: 'Team', href: '/team/', stat: 'Who does what' },
	{ what: 'Time tracking', where: 'Time tracking', href: '/time/', stat: `${formatHours(totalHours)} logged` },
	{ what: 'Detailed planning', where: 'Planning', href: '/planning/', stat: plural(milestones.length, 'date') },
	{ what: 'Guidance from AI', where: 'Logbook, AI tag', href: '/logbook/?f=ai', stat: plural(has(tagged('ai')), 'post') },
];

// The concept in four points (from our concept text after the client meeting of 19 Nov).
const conceptPoints = [
	{ title: 'The gate', text: 'One wall is a game screen, the other wall and the ceiling one animation in black, white and blue.' },
	{ title: 'The window', text: 'An abstract shape shows the group at the other gate, moving with them. You see strangers are there, never who.' },
	{ title: 'Building together', text: 'Each round is one material. Most people in front of a version wins, then the halls switch roles.' },
	{ title: 'The street', text: 'Every finished house starts a new one next door. Afterwards, a QR code lets you follow the street online.' },
];

// The tiles around the name in the hero: one per way into the logbook. Pillars in their colour, Planning and Hours in their own, Team in white.
// Three on each side, the middle ones further out, so they ring the name without touching it.
const tiles = [
	{ label: 'UX', sub: plural(has(inPillar('ux')), 'post'), href: '/logbook/?f=ux', color: PILLARS.ux.color, x: 14, y: 5, slant: 'up', depth: 1.4 },
	{ label: 'Design', sub: plural(has(inPillar('design')), 'post'), href: '/logbook/?f=design', color: PILLARS.design.color, x: 68, y: 5, slant: 'down', depth: 0.8 },
	{ label: 'Dev', sub: plural(has(inPillar('dev')), 'post'), href: '/logbook/?f=dev', color: PILLARS.dev.color, x: 0, y: 41, slant: 'up', depth: 1 },
	{ label: 'Planning', sub: plural(milestones.length, 'date'), href: '/planning/', color: 'var(--c-planning)', x: 82, y: 41, slant: 'down', depth: 1.6 },
	{ label: 'Hours', sub: formatHours(totalHours), href: '/time/', color: 'var(--c-hours)', x: 14, y: 77, slant: 'up', depth: 0.7 },
	{ label: 'Team', sub: PROJECT.members, href: '/team/', color: 'var(--fg)', x: 68, y: 77, slant: 'down', depth: 1.2 },
] as const;
---

<Layout>
	<!-- Just the name, as on our presentation slides, with the ways into the logbook around it. -->
	<section class="wrap hero">
		<Tiles tiles={[...tiles]} label="Explore the logbook">
			<h1>
				<span class="name" aria-hidden="true">{PROJECT.concept}<span class="dot"></span></span>
				<span class="sr-only">
					{PROJECT.concept}: logbook of BAP {PROJECT.team}, {PROJECT.title}, for {PROJECT.client}
				</span>
			</h1>
		</Tiles>
	</section>

	<div class="wrap">
		<dl class="stats" data-stagger>
			<div>
				<dt class="label">Posts</dt>
				<dd>{entries.length}</dd>
			</div>
			<div>
				<dt class="label">Hours logged</dt>
				<dd>{formatHours(totalHours)}</dd>
			</div>
			<div>
				<dt class="label">Dates planned</dt>
				<dd>{milestones.length}</dd>
			</div>
			<div class="now">
				<dt class="label">{currentWeek ? currentWeek.data.label : 'Now'}</dt>
				<dd class="text">{currentWeek?.data.focus ?? '—'}</dd>
			</div>
		</dl>
	</div>

	<section class="wrap section">
		<div class="sec-head" data-reveal>
			<h2>For our teachers</h2>
			<p class="muted">Where to find each part of the assignment</p>
		</div>
		<ol class="tiles" data-stagger>
			{
				requirements.map((r, i) => (
					<li>
						<a href={r.href}>
							<span class="tile-no">{String(i + 1).padStart(2, '0')}</span>
							<span class="tile-title">{r.what}</span>
							<span class="tile-where">{r.where}</span>
							<span class="tile-stat">{r.stat} →</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<section class="wrap section concept">
		<div data-reveal>
			<div class="sec-head">
				<h2>Current concept</h2>
			</div>
			<p class="concept-text">
				In each hall stands a slim, open gate that visitors walk straight through. Together, the two halls build a
				house: one hall chooses a material by standing in front of the version they want to send, the other decides
				where it goes. Room by room and house by house, a whole street grows over the two days.
			</p>
			<dl class="concept-points">
				{
					conceptPoints.map((p) => (
						<div>
							<dt>{p.title}</dt>
							<dd>{p.text}</dd>
						</div>
					))
				}
			</dl>
			{brainstorm && <a class="link" href={`/logbook/${brainstorm.id}/`}>Where it started</a>}
		</div>
		<div data-reveal>
			<SitePlan />
		</div>
	</section>

	<section class="wrap section">
		<div class="sec-head" data-reveal>
			<h2>Latest in the logbook</h2>
			<a href="/logbook/" class="btn">All {entries.length} posts</a>
		</div>
		<PostList entries={entries.slice(0, 4)} />
	</section>

	<section class="wrap section two-col">
		<div data-reveal>
			<div class="sec-head">
				<h2>Coming up</h2>
				<a class="link" href="/planning/">Full planning</a>
			</div>
			<ul class="dates">
				{
					upcoming.map((m) => (
						<li class={m.data.type}>
							<span class="d">
								<FormattedDate date={m.data.date} style="day" />
							</span>
							<span>
								{m.data.title}
								{m.data.time && <span class="muted"> · {m.data.time}</span>}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<div data-reveal>
			<div class="sec-head">
				<h2>Contacts</h2>
			</div>
			<ul class="contacts">
				{
					CLIENT_CONTACTS.map((c) => (
						<li>
							<span>{c.name}</span>
							<span class="muted">{c.role}, {PROJECT.client}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-block: 24px 40px;
	}

	/* The name as in the logo: lowercase Poppins with a blue square for a full stop. */
	h1 .name {
		display: block;
		font-size: clamp(60px, 11vw, 148px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.04em;
		animation: title-in 0.9s 0.1s var(--ease) both;
	}

	.dot {
		display: inline-block;
		width: 0.17em;
		height: 0.17em;
		margin-left: 0.05em;
		background: var(--accent);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 0;
		border-top: 1px solid var(--line-strong);
		border-bottom: 1px solid var(--line);
	}

	.stats > div {
		padding: 20px 24px 24px 0;
	}

	.stats > div + div {
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}

	.stats .now .label {
		color: var(--accent-text);
	}

	.stats dd {
		margin: 10px 0 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 36px;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}

	.stats dd.text {
		font-size: 19px;
		line-height: 1.3;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tiles a {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 168px;
		padding: 18px 20px;
		overflow: hidden;
		background: var(--surface);
		text-decoration: none;
		isolation: isolate;
	}

	/* A slanted blue panel wipes in on hover. */
	.tiles a::before {
		content: '';
		position: absolute;
		inset: 0 -30%;
		z-index: -1;
		background: var(--accent);
		transform: translateX(-110%) skewX(-20deg);
		transition: transform 0.5s var(--ease);
	}

	.tiles a:hover::before,
	.tiles a:focus-visible::before {
		transform: translateX(0) skewX(-20deg);
	}

	.tile-no {
		font-size: 12px;
		font-weight: 700;
		color: var(--muted);
	}

	.tile-title {
		margin-top: 8px;
		font-size: 21px;
		line-height: 1.2;
	}

	.tile-where {
		margin-top: 6px;
		color: var(--muted);
		font-size: 14px;
	}

	.tile-stat {
		margin-top: auto;
		padding-top: 18px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-text);
	}

	.tiles a:hover,
	.tiles a:focus-visible {
		color: var(--on-accent);
	}

	.tiles a:hover :is(.tile-no, .tile-where, .tile-stat),
	.tiles a:focus-visible :is(.tile-no, .tile-where, .tile-stat) {
		color: rgba(255, 255, 255, 0.8);
	}

	.concept {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 48px;
		align-items: center;
	}

	.concept-points {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px 28px;
		margin: 0 0 24px;
	}

	.concept-points dt {
		font-family: var(--font-display);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.concept-points dd {
		margin: 4px 0 0;
		font-size: 15px;
		line-height: 1.5;
		color: var(--fg-soft);
	}

	.concept-text {
		margin: 0 0 24px;
		max-width: 52ch;
		color: var(--fg-soft);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 48px;
	}

	.dates,
	.contacts {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line-strong);
	}

	.dates li {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
	}

	.dates .d {
		font-weight: 700;
		color: var(--muted);
	}

	.dates .deadline .d {
		color: var(--deadline);
	}

	.dates .jury {
		font-weight: 700;
	}

	.contacts li {
		display: flex;
		flex-direction: column;
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
	}

	@media (max-width: 900px) {
		.concept,
		.two-col {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.stats {
			grid-template-columns: 1fr 1fr;
		}

		.concept-points {
			grid-template-columns: 1fr;
		}

		.stats > div + div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}

		.stats > div:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}

	}
</style>
