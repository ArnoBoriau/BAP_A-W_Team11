---
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import SitePlan from '../components/SitePlan.astro';
import Tiles from '../components/Tiles.astro';
import { CLIENT_CONTACTS, MEMBER_COLORS, PILLARS, PROJECT } from '../consts';
import Layout from '../layouts/Layout.astro';
import { DAY, formatDate, formatHours, getEntries, getPlanning, getTimeLog, sum, today } from '../lib/data';

const [entries, time, { weeks, milestones }] = await Promise.all([getEntries(), getTimeLog(), getPlanning()]);

const now = today();
const upcoming = milestones.filter((m) => m.data.date >= now).slice(0, 4);
const currentWeek =
	weeks.find((w) => w.data.start <= now && now <= new Date(w.data.end.valueOf() + 2 * DAY)) ??
	weeks.find((w) => w.data.start > now);
const totalHours = sum(time.map((t) => t.data.hours));
const brainstorm = entries.find((e) => e.id.includes('brainstorm'));

const has = (fn: (e: (typeof entries)[number]) => boolean) => entries.filter(fn).length;
const tagged = (...tags: string[]) => (e: (typeof entries)[number]) => tags.some((t) => e.data.tags.includes(t as never));
const inPillar = (id: string) => (e: (typeof entries)[number]) => e.data.pillar === id;
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// The parts of the BAP assignment, and where to find each of them.
const requirements = [
	{ what: 'Research documentation', where: 'Logbook, Research tag', href: '/logbook/?f=research', stat: plural(has(tagged('research')), 'post') },
	{ what: 'Process towards the result', where: 'Logbook, Process tag', href: '/logbook/?f=process', stat: plural(has(tagged('process')), 'post') },
	{ what: 'Feedback reports', where: 'Logbook, Feedback & experts', href: '/logbook/?f=feedback', stat: plural(has(tagged('feedback-client', 'expert-talk')), 'report') },
	{ what: 'Team roles', where: 'Team', href: '/team/', stat: 'Who does what' },
	{ what: 'Time tracking', where: 'Time tracking', href: '/time/', stat: `${formatHours(totalHours)} logged` },
	{ what: 'Detailed planning', where: 'Planning', href: '/planning/', stat: plural(milestones.length, 'date') },
	{ what: 'Guidance from AI', where: 'Logbook, AI tag', href: '/logbook/?f=ai', stat: plural(has(tagged('ai')), 'post') },
];

// The tile cluster in the hero: one tile per way into the logbook.
const tiles = [
	{ label: 'UX', sub: plural(has(inPillar('ux')), 'post'), href: '/logbook/?f=ux', color: PILLARS.ux.color, x: 4, y: 8, slant: 'up', depth: 1.4 },
	{ label: 'Design', sub: plural(has(inPillar('design')), 'post'), href: '/logbook/?f=design', color: PILLARS.design.color, x: 56, y: 19, slant: 'down', depth: 0.8 },
	{ label: 'Dev', sub: plural(has(inPillar('dev')), 'post'), href: '/logbook/?f=dev', color: PILLARS.dev.color, x: 4, y: 36, slant: 'up', depth: 1 },
	{ label: 'Planning', sub: plural(milestones.length, 'date'), href: '/planning/', color: '#d2a6b5', x: 56, y: 47, slant: 'down', depth: 1.6 },
	{ label: 'Hours', sub: formatHours(totalHours), href: '/time/', color: MEMBER_COLORS[3], x: 4, y: 64, slant: 'up', depth: 0.7 },
	{ label: 'Team', sub: PROJECT.members, href: '/team/', color: '#f2f0eb', x: 56, y: 75, slant: 'down', depth: 1.2 },
] as const;
---

<Layout>
	<section class="wrap hero">
		<div class="intro">
			<span class="badge">BAP · {PROJECT.team} · {PROJECT.client}</span>
			<h1>
				{PROJECT.title.split(' ').map((word, i) => <span style={`--i: ${i}`}>{word}</span>)}
			</h1>
			<ul class="facts">
				<li>{PROJECT.event}</li>
				<li>{formatDate(new Date(PROJECT.start))} – {formatDate(new Date(PROJECT.end), 'long')}</li>
			</ul>
			<p class="lead">
				We're turning two walls in the arrival zone into an interactive experience. This logbook documents
				everything: research, process, feedback, planning, hours and AI use.
			</p>
			<div class="actions">
				<a href="/logbook/" class="btn btn--primary">Open the logbook</a>
				<a href="/planning/" class="btn">Planning</a>
			</div>
		</div>
		<Tiles tiles={[...tiles]} label="Explore the logbook" />
	</section>

	<div class="wrap">
		<dl class="stats" data-stagger>
			<div>
				<dt class="label">Posts</dt>
				<dd>{entries.length}</dd>
			</div>
			<div>
				<dt class="label">Hours logged</dt>
				<dd>{formatHours(totalHours)}</dd>
			</div>
			<div>
				<dt class="label">Dates planned</dt>
				<dd>{milestones.length}</dd>
			</div>
			<div class="now">
				<dt class="label">{currentWeek ? currentWeek.data.label : 'Now'}</dt>
				<dd class="text">{currentWeek?.data.focus ?? '—'}</dd>
			</div>
		</dl>
	</div>

	<section class="wrap section">
		<div class="sec-head" data-reveal>
			<h2>For our teachers</h2>
			<p class="muted">Where to find each part of the assignment</p>
		</div>
		<ol class="tiles" data-stagger>
			{
				requirements.map((r, i) => (
					<li>
						<a href={r.href}>
							<span class="tile-no">{String(i + 1).padStart(2, '0')}</span>
							<span class="tile-title">{r.what}</span>
							<span class="tile-where">{r.where}</span>
							<span class="tile-stat">{r.stat} →</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<section class="wrap section concept">
		<div data-reveal>
			<div class="sec-head">
				<h2>Current concept</h2>
			</div>
			<p class="concept-name">{PROJECT.concept}</p>
			<p class="concept-text">
				Latin for window. The two walls become neighbouring buildings, 90 m apart, and visitors bring them to life
				with their presence. When two strangers stand at the same spot in different halls, a window opens and they
				see each other.
			</p>
			{brainstorm && <a class="link" href={`/logbook/${brainstorm.id}/`}>How we got here</a>}
		</div>
		<div data-reveal>
			<SitePlan />
		</div>
	</section>

	<section class="wrap section">
		<div class="sec-head" data-reveal>
			<h2>Latest in the logbook</h2>
			<a href="/logbook/" class="btn">All {entries.length} posts</a>
		</div>
		<PostList entries={entries.slice(0, 4)} />
	</section>

	<section class="wrap section two-col">
		<div data-reveal>
			<div class="sec-head">
				<h2>Coming up</h2>
				<a class="link" href="/planning/">Full planning</a>
			</div>
			<ul class="dates">
				{
					upcoming.map((m) => (
						<li class={m.data.type}>
							<span class="d">
								<FormattedDate date={m.data.date} style="day" />
							</span>
							<span>
								{m.data.title}
								{m.data.time && <span class="muted"> · {m.data.time}</span>}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<div data-reveal>
			<div class="sec-head">
				<h2>Contacts</h2>
			</div>
			<ul class="contacts">
				{
					CLIENT_CONTACTS.map((c) => (
						<li>
							<span>{c.name}</span>
							<span class="muted">{c.role}, {PROJECT.client}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 64px;
		align-items: center;
		padding-block: 56px 72px;
	}

	.badge {
		display: inline-block;
		padding: 3px 7px;
		background: var(--fg);
		color: var(--bg);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		animation: fade-up 0.8s var(--ease) both;
	}

	h1 {
		display: flex;
		flex-direction: column;
		margin-top: 20px;
		font-size: clamp(44px, 6.4vw, 92px);
		line-height: 0.92;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	/* One word per line, each sliding up in turn. */
	h1 span {
		display: block;
		animation: title-in 0.9s calc(0.1s + var(--i) * 0.1s) var(--ease) both;
	}

	h1 span:last-child {
		color: var(--accent);
	}

	.facts {
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
		font-weight: 700;
		animation: fade-up 0.8s 0.4s var(--ease) both;
	}

	.facts li + li {
		margin-top: 4px;
	}

	.lead {
		margin-top: 16px;
		max-width: 50ch;
		color: var(--fg-soft);
		animation: fade-up 0.8s 0.5s var(--ease) both;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
		animation: fade-up 0.8s 0.6s var(--ease) both;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 0;
		border-top: 1px solid var(--line-strong);
		border-bottom: 1px solid var(--line);
	}

	.stats > div {
		padding: 20px 24px 24px 0;
	}

	.stats > div + div {
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}

	.stats .now .label {
		color: var(--accent);
	}

	.stats dd {
		margin: 10px 0 0;
		font-size: 36px;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}

	.stats dd.text {
		font-size: 19px;
		line-height: 1.3;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tiles a {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 168px;
		padding: 18px 20px;
		overflow: hidden;
		background: var(--surface);
		text-decoration: none;
		isolation: isolate;
	}

	/* A slanted blue panel wipes in on hover. */
	.tiles a::before {
		content: '';
		position: absolute;
		inset: 0 -30%;
		z-index: -1;
		background: var(--accent);
		transform: translateX(-110%) skewX(-20deg);
		transition: transform 0.5s var(--ease);
	}

	.tiles a:hover::before,
	.tiles a:focus-visible::before {
		transform: translateX(0) skewX(-20deg);
	}

	.tile-no {
		font-size: 12px;
		font-weight: 700;
		color: var(--muted);
	}

	.tile-title {
		margin-top: 8px;
		font-size: 21px;
		line-height: 1.2;
	}

	.tile-where {
		margin-top: 6px;
		color: var(--muted);
		font-size: 14px;
	}

	.tile-stat {
		margin-top: auto;
		padding-top: 18px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.tiles a:hover,
	.tiles a:focus-visible {
		color: var(--ink);
	}

	.tiles a:hover :is(.tile-no, .tile-where, .tile-stat),
	.tiles a:focus-visible :is(.tile-no, .tile-where, .tile-stat) {
		color: rgba(11, 11, 10, 0.75);
	}

	.concept {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 48px;
		align-items: center;
	}

	.concept-name {
		font-size: clamp(56px, 8vw, 104px);
		line-height: 0.95;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.concept-text {
		margin: 20px 0 16px;
		max-width: 52ch;
		color: var(--fg-soft);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 48px;
	}

	.dates,
	.contacts {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line-strong);
	}

	.dates li {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
	}

	.dates .d {
		font-weight: 700;
		color: var(--muted);
	}

	.dates .deadline .d {
		color: var(--deadline);
	}

	.dates .jury {
		font-weight: 700;
	}

	.contacts li {
		display: flex;
		flex-direction: column;
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
	}

	@media (max-width: 900px) {
		.hero,
		.concept,
		.two-col {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.stats {
			grid-template-columns: 1fr 1fr;
		}

		.stats > div + div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}

		.stats > div:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}

		.hero :global(.cluster) {
			max-width: 320px;
		}
	}
</style>
